# Required on first run (min 8 characters) — creates admin "AMROUS ABDALLAH"
ADMIN_PASSWORD=change-me-min-8-chars

PORT=4000
NODE_ENV=development

# Optional: override auto-generated key in backend/data/.app-key (64 hex chars = 32 bytes)
# APP_ENCRYPTION_KEY=

# Comma-separated allowed frontend origins
CORS_ORIGIN=http://localhost:3000
